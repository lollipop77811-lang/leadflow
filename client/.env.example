# Demo mode: the dashboard runs entirely in the browser with realistic demo
# data, and ANY email + password signs in. Use this for client walkthroughs.
VITE_DEMO_MODE=true

# Real backend mode: set VITE_DEMO_MODE=false and run the Express API
# (`cd server && npm start`); Vite proxies /api to http://localhost:5000.
# VITE_DEMO_MODE=false
