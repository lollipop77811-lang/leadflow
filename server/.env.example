# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# ------------------------------------------------------------------

# MongoDB Atlas connection string (Database Access user + cluster host)
# Example: mongodb+srv://leadflow_user:PASSWORD@cluster0.ab12cd.mongodb.net/leadflow?retryWrites=true&w=majority
MONGODB_URI=

# If MONGODB_URI is empty or unreachable, the server boots an in-memory
# MongoDB so the app always runs. Set to "false" to disable that fallback.
ALLOW_MEMORY_DB=true
# Insert 15 demo car leads on an empty database. Set to false in production.
SEED_DEMO=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account auto-created on first boot (change before going live)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@leadflow.dev
ADMIN_PASSWORD=admin123

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Car-scrapping specifics
# ------------------------------------------------------------------
# ₹ per kg used by the quote calculator
SCRAP_RATE_PER_KG=20

# Optional service area — comma separated pincode prefixes.
# Leave empty to accept every pincode.
SERVICE_PINCODES=

# Shown on the public form (trust signals)
BRAND_NAME=LeadFlow Autoscrap
RVSF_NUMBER=RVSF/UP/2024/0000
BRAND_PHONE=+91 90000 00000
BRAND_WHATSAPP=919000000000

# ------------------------------------------------------------------
# Instant new-lead alerts (optional, both may be left empty)
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
