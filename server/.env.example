# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# ------------------------------------------------------------------

# MongoDB Atlas connection string (Database Access user + cluster host)
# Example: mongodb+srv://leadflow_user:PASSWORD@cluster0.ab12cd.mongodb.net/leadflow?retryWrites=true&w=majority
MONGODB_URI=

# If MONGODB_URI is empty or unreachable, the server boots an in-memory
# MongoDB so the app always runs. Set to "false" to disable that fallback.
ALLOW_MEMORY_DB=true
SEED_DEMO=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account auto-created on first boot (change before going live)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@leadflow.dev
ADMIN_PASSWORD=admin123

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
